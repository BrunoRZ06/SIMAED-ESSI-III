generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReferenceMatrix {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  year           Int
  evaluationType String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  descriptors Descriptor[]
}

model Stage {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  descriptors Descriptor[]
}

model Discipline {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  descriptors Descriptor[]
}

model Descriptor {
  id          String   @id @default(uuid())
  code        String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matrixId     String
  stageId      String
  disciplineId String

  matrix     ReferenceMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  stage      Stage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  discipline Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([matrixId, stageId, disciplineId, code])
  @@index([stageId, disciplineId])
}

model MockExamGenerationRequest {
  id             Int              @id @default(autoincrement())
  requestId      String           @unique @default(uuid())
  status         GenerationStatus @default(PENDING)

  disciplineCode String
  stageCode      String
  descriptorIds  String[]
  questionCount  Int
  difficulty     String
  questionType   String

  configHash     String
  errorMessage   String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([configHash, createdAt])
  @@index([status])
}
